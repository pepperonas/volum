# Model weights — never committed (see docs/licenses.md)
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
*.gguf
*.onnx
weights/
checkpoints/

# Generated 3D assets and runtime data.
#
# These are ANCHORED to the repository root with a leading slash. Without it,
# `jobs/` also matched engine/src/volum_core/jobs/ and silently excluded a
# source package from the repository — the code ran locally and was simply
# absent for everyone else. An unanchored directory pattern in .gitignore
# matches at every depth.
*.glb
*.gltf
*.fbx
*.usdz
*.3mf
/data/
/exports/
/jobs/
/projects/
/cache/
/logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
.vite/
coverage/
playwright-report/
test-results/

# Rust / Tauri
target/
src-tauri/target/
# Tauri regenerates its capability schemas on every build.
#
# ⚠️ The `**/` is load-bearing: a pattern containing a slash is anchored to the
# directory holding the .gitignore, so a bare `gen/schemas/` would only ever
# match one at the repository root — not the one under apps/desktop/src-tauri.
**/gen/schemas/

# Browser-automation artefacts from local verification runs.
.playwright-mcp/

# Secrets
.env
.env.local
!.env.example

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
